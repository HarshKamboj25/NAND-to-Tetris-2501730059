// Hack CPU: executes 16-bit Hack instructions.
CHIP CPU {
    IN  inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // Instruction type and destination decoding.
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=destA);
    Or(a=isA, b=destA, out=loadA);
    And(a=instruction[15], b=instruction[4], out=loadD);
    And(a=instruction[15], b=instruction[3], out=writeM);

    // A-instruction loads instruction value; C dest=A loads ALU result.
    Mux16(a=aluOut, b=instruction, sel=isA, out=aInput);
    ARegister(in=aInput, load=loadA, out=aReg, out[0..14]=addressM);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // ALU inputs: x=D, y=A or M.
    Mux16(a=aReg, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dReg, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, zr=zr, ng=ng);
    Or16(a=aluOut, b=false, out=outM);

    // Hack jump bits: bit 2=JLT, bit 1=JEQ, bit 0=JGT.
    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);
    And(a=notNg, b=notZr, out=isPositive);
    And(a=instruction[2], b=ng, out=jumpLT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[0], b=isPositive, out=jumpGT);
    Or(a=jumpLT, b=jumpEQ, out=jumpLE);
    Or(a=jumpLE, b=jumpGT, out=jumpAny);
    And(a=instruction[15], b=jumpAny, out=loadPC);

    PC(in=aReg, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}
