// Hack memory map:
// RAM16K: 0..16383; Screen: 16384..24575; Keyboard: 24576.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Writes: RAM when A14=0; Screen when A14=1 and A13=0.
    Not(in=address[14], out=notA14);
    Not(in=address[13], out=notA13);
    And(a=load, b=notA14, out=ramLoad);
    And(a=load, b=address[14], out=upperLoad);
    And(a=upperLoad, b=notA13, out=screenLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    // Reads: A14=0 selects RAM; otherwise A13 selects Screen or Keyboard.
    Mux16(a=screenOut, b=keyboardOut, sel=address[13], out=upperOut);
    Mux16(a=ramOut, b=upperOut, sel=address[14], out=out);
}
